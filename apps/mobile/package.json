{
  "name": "@quilt/mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@better-auth/expo": "1.7.17",
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "15.1.1",
    "@quilt/contracts": "workspace:*",
    "@quilt/domain": "workspace:*",
    "@quilt/ui": "workspace:*",
    "better-auth": "1.7.17",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-network": "58.0.4",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.0.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "zod": "catalog:",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@quilt/eslint-config": "workspace:*",
    "@quilt/prettier-config": "workspace:*",
    "@quilt/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native-tests.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "test": "vitest run"
  },
  "private": true,
  "prettier": "@quilt/prettier-config"
}
