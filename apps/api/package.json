{
  "name": "@quilt/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.17",
    "@better-auth/expo": "1.7.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@quilt/contracts": "workspace:*",
    "@quilt/db": "workspace:*",
    "@quilt/domain": "workspace:*",
    "@quilt/emails": "workspace:*",
    "better-auth": "1.7.17",
    "fastify": "5.11.3",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@quilt/eslint-config": "workspace:*",
    "@quilt/prettier-config": "workspace:*",
    "@quilt/typescript-config": "workspace:*",
    "@types/nodemailer": "8.0.2",
    "pino-pretty": "13.2.0",
    "vitest": "catalog:"
  },
  "prettier": "@quilt/prettier-config"
}
