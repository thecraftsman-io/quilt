# API Server
PORT=3000
# LOG_LEVEL=debug # fatal, error, warn, info, debug, trace, silent
# Exact allowed origins, comma-separated. Expo web defaults to port 8081.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=quilt
POSTGRES_PASSWORD=quilt
POSTGRES_DB=quilt
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quilt:quilt@localhost:5432/quilt

# Redis (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Better Auth (Required: generate with: openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Social Providers (Optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Mailpit (local email testing via docker-compose)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Account verification emails (Mailpit in local development)
APP_URL=http://localhost:8082
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
MAIL_FROM=hello@quilt.local
# Set both for authenticated SMTP providers:
# SMTP_USER=
# SMTP_PASSWORD=
