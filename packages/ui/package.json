{
  "name": "@quilt/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check ."
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@quilt/typescript-config": "workspace:*",
    "@quilt/eslint-config": "workspace:*",
    "@quilt/prettier-config": "workspace:*"
  },
  "dependencies": {
    "tamagui": "3.2.2",
    "@tamagui/config": "3.2.2",
    "@tamagui/tailwind": "3.2.2",
    "tailwindcss": "catalog:",
    "react-email": "6.11.6"
  },
  "type": "module",
  "prettier": "@quilt/prettier-config"
}
